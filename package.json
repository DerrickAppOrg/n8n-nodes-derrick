{
  "name": "n8n-nodes-derrick",
  "version": "0.1.0",
  "description": "n8n node for Derrick: find work emails and phone numbers, enrich LinkedIn profiles and companies, detect tech stacks, and find lookalike companies.",
  "keywords": [
    "n8n-community-node-package",
    "derrick",
    "b2b",
    "lead-generation",
    "data-enrichment",
    "email-finder"
  ],
  "license": "MIT",
  "homepage": "https://derrick-app.com",
  "author": {
    "name": "Derrick",
    "email": "contact@derrick-app.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DerrickAppOrg/n8n-nodes-derrick.git"
  },
  "main": "index.js",
  "scripts": {
    "build": "npx rimraf dist && tsc && gulp build:icons",
    "dev": "tsc --watch",
    "format": "prettier nodes credentials --write",
    "lint": "eslint nodes credentials package.json",
    "lintfix": "eslint nodes credentials package.json --fix",
    "prepublishOnly": "npm run build && npm run lint"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/DerrickApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Derrick/Derrick.node.js"
    ]
  },
  "devDependencies": {
    "@typescript-eslint/parser": "^8.32.0",
    "eslint": "^8.57.0",
    "eslint-plugin-n8n-nodes-base": "^1.16.3",
    "gulp": "^5.0.0",
    "n8n-workflow": "*",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
